{
  "name": "malt",
  "displayName": "MALT",
  "description": "Review changes as you code. Inline block reviews, project standards, and a local Claude reviewer for VS Code.",
  "version": "0.0.1",
  "publisher": "division4studios",
  "license": "MIT",
  "homepage": "https://github.com/Division4Studios/multi-agent-local-team#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Division4Studios/multi-agent-local-team.git"
  },
  "bugs": {
    "url": "https://github.com/Division4Studios/multi-agent-local-team/issues"
  },
  "engines": {
    "vscode": "^1.144.0",
    "node": ">=24"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "malt",
          "title": "MALT",
          "icon": "media/malt.svg"
        }
      ]
    },
    "views": {
      "malt": [
        {
          "id": "malt.reviewer",
          "name": "Reviewer"
        },
        {
          "id": "malt.changes",
          "name": "Changes"
        },
        {
          "id": "malt.pullRequest",
          "name": "Pull Request"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "malt.changes",
        "contents": "Your next change starts here.\nSave a file in a Git repository to see its changed blocks. MALT skips Git-ignored files and its own .malt folder. Select a block to jump to it; hover in the editor for the review.\n[Start Reviewer](command:malt.startReviewer)\n[Scan Project Standards](command:malt.scanStandards)"
      },
      {
        "view": "malt.pullRequest",
        "contents": "Review a GitHub pull request the same way MALT reviews your own changes: every changed block outlined and checked against your project standards, with plain-English hover cards.\nMALT checks the pull request out in this workspace (it refuses if you have uncommitted changes) and returns you to your branch when you finish. Results stay in VS Code; nothing is posted to GitHub.\n[Review Pull Request…](command:malt.reviewPullRequest)",
        "when": "!malt.pullRequestActive"
      }
    ],
    "commands": [
      {
        "command": "malt.startReviewer",
        "title": "Start Reviewer",
        "category": "MALT",
        "icon": "$(play)"
      },
      {
        "command": "malt.stopReviewer",
        "title": "Stop Reviewer",
        "category": "MALT",
        "icon": "$(debug-stop)"
      },
      {
        "command": "malt.scanStandards",
        "title": "Scan Project Standards (Rescan)",
        "category": "MALT",
        "icon": "$(checklist)"
      },
      {
        "command": "malt.reviewAll",
        "title": "Review All Unreviewed Changes",
        "category": "MALT",
        "icon": "$(run-all)"
      },
      {
        "command": "malt.showReviewerLogs",
        "title": "Show Reviewer Logs",
        "category": "MALT",
        "icon": "$(output)"
      },
      {
        "command": "malt.setCredentials",
        "title": "Set Claude Credentials",
        "category": "MALT",
        "icon": "$(key)"
      },
      {
        "command": "malt.clearCredentials",
        "title": "Clear Claude Credentials",
        "category": "MALT",
        "icon": "$(trash)"
      },
      {
        "command": "malt.reviewAgain",
        "title": "Review Again",
        "category": "MALT",
        "icon": "$(refresh)"
      },
      {
        "command": "malt.revealHunk",
        "title": "Reveal Change",
        "category": "MALT",
        "icon": "$(go-to-file)"
      },
      {
        "command": "malt.showRuleCheck",
        "title": "Show Rule Result",
        "category": "MALT",
        "icon": "$(book)"
      },
      {
        "command": "malt.checkConsolidation",
        "title": "Check Consolidation Across Changes",
        "category": "MALT",
        "icon": "$(git-merge)"
      },
      {
        "command": "malt.showStandardsGaps",
        "title": "Show Standards Gaps",
        "category": "MALT",
        "icon": "$(question)"
      },
      {
        "command": "malt.showFinding",
        "title": "Show Consolidation Finding",
        "category": "MALT",
        "icon": "$(book)"
      },
      {
        "command": "malt.showLiveLog",
        "title": "Show Live Reviewer Log",
        "category": "MALT",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "malt.showStandards",
        "title": "Show Project Standards",
        "category": "MALT",
        "icon": "$(book)"
      },
      {
        "command": "malt.showArchitecture",
        "title": "Show Architecture Map",
        "category": "MALT",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "malt.showRule",
        "title": "Show Rule",
        "category": "MALT"
      },
      {
        "command": "malt.showGap",
        "title": "Show Where This Gap Applies",
        "category": "MALT",
        "icon": "$(go-to-file)"
      },
      {
        "command": "malt.showGapDetails",
        "title": "Show Gap Details",
        "category": "MALT",
        "icon": "$(info)"
      },
      {
        "command": "malt.showFindingLocation",
        "title": "Show Where This Applies",
        "category": "MALT",
        "icon": "$(go-to-file)"
      },
      {
        "command": "malt.configureReviewType",
        "title": "Change Review Model and Effort",
        "category": "MALT",
        "icon": "$(settings-gear)"
      },
      {
        "command": "malt.investigateGap",
        "title": "Investigate Gap (Read the Code)",
        "category": "MALT",
        "icon": "$(search)"
      },
      {
        "command": "malt.investigateAllGaps",
        "title": "Investigate All Standards Gaps",
        "category": "MALT",
        "icon": "$(search-fuzzy)"
      },
      {
        "command": "malt.showInvestigation",
        "title": "Show Gap Investigation",
        "category": "MALT",
        "icon": "$(book)"
      },
      {
        "command": "malt.showEvidence",
        "title": "Show Evidence in the Code",
        "category": "MALT",
        "icon": "$(quote)"
      },
      {
        "command": "malt.reviewPullRequest",
        "title": "Review Pull Request…",
        "category": "MALT",
        "icon": "$(git-pull-request)"
      },
      {
        "command": "malt.finishPullRequestReview",
        "title": "Finish Pull Request Review",
        "category": "MALT",
        "icon": "$(check-all)"
      },
      {
        "command": "malt.reviewPullRequestBlocks",
        "title": "Review All Pull Request Blocks",
        "category": "MALT",
        "icon": "$(run-all)"
      },
      {
        "command": "malt.openPullRequestOnGitHub",
        "title": "Open Pull Request on GitHub",
        "category": "MALT",
        "icon": "$(github)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "malt.startReviewer",
          "when": "view == malt.reviewer && malt.reviewerState != running && malt.reviewerState != starting",
          "group": "navigation@1"
        },
        {
          "command": "malt.stopReviewer",
          "when": "view == malt.reviewer && malt.reviewerState == running",
          "group": "navigation@1"
        },
        {
          "command": "malt.scanStandards",
          "when": "view == malt.reviewer",
          "group": "navigation@2"
        },
        {
          "command": "malt.showReviewerLogs",
          "when": "view == malt.reviewer",
          "group": "navigation@4"
        },
        {
          "command": "malt.setCredentials",
          "when": "view == malt.reviewer",
          "group": "settings"
        },
        {
          "command": "malt.clearCredentials",
          "when": "view == malt.reviewer",
          "group": "settings"
        },
        {
          "command": "malt.reviewAll",
          "when": "view == malt.changes",
          "group": "navigation@1"
        },
        {
          "command": "malt.checkConsolidation",
          "when": "view == malt.changes",
          "group": "navigation@2"
        },
        {
          "command": "malt.showLiveLog",
          "when": "view == malt.reviewer",
          "group": "navigation@3"
        },
        {
          "command": "malt.reviewPullRequest",
          "when": "view == malt.pullRequest && !malt.pullRequestActive",
          "group": "navigation@1"
        },
        {
          "command": "malt.reviewPullRequestBlocks",
          "when": "view == malt.pullRequest && malt.pullRequestActive",
          "group": "navigation@1"
        },
        {
          "command": "malt.openPullRequestOnGitHub",
          "when": "view == malt.pullRequest && malt.pullRequestActive",
          "group": "navigation@2"
        },
        {
          "command": "malt.finishPullRequestReview",
          "when": "view == malt.pullRequest && malt.pullRequestActive",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "malt.reviewAgain",
          "when": "(view == malt.changes || view == malt.pullRequest) && viewItem == malt.hunk",
          "group": "inline"
        },
        {
          "command": "malt.showGapDetails",
          "when": "view == malt.reviewer && viewItem == malt.gap",
          "group": "inline@2"
        },
        {
          "command": "malt.showFinding",
          "when": "(view == malt.changes || view == malt.pullRequest) && viewItem == malt.finding",
          "group": "inline"
        },
        {
          "command": "malt.investigateGap",
          "when": "view == malt.reviewer && viewItem == malt.gap",
          "group": "inline@1"
        },
        {
          "command": "malt.investigateAllGaps",
          "when": "view == malt.reviewer && viewItem == malt.gaps",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "malt.reviewAgain",
          "when": "false"
        },
        {
          "command": "malt.revealHunk",
          "when": "false"
        },
        {
          "command": "malt.showRuleCheck",
          "when": "false"
        },
        {
          "command": "malt.showFinding",
          "when": "false"
        },
        {
          "command": "malt.showRule",
          "when": "false"
        },
        {
          "command": "malt.showGap",
          "when": "false"
        },
        {
          "command": "malt.showGapDetails",
          "when": "false"
        },
        {
          "command": "malt.showFindingLocation",
          "when": "false"
        },
        {
          "command": "malt.configureReviewType",
          "when": "false"
        },
        {
          "command": "malt.investigateGap",
          "when": "false"
        },
        {
          "command": "malt.showInvestigation",
          "when": "false"
        },
        {
          "command": "malt.showEvidence",
          "when": "false"
        },
        {
          "command": "malt.finishPullRequestReview",
          "when": "malt.pullRequestActive"
        },
        {
          "command": "malt.reviewPullRequestBlocks",
          "when": "malt.pullRequestActive"
        },
        {
          "command": "malt.openPullRequestOnGitHub",
          "when": "malt.pullRequestActive"
        }
      ]
    },
    "configuration": {
      "title": "MALT",
      "properties": {
        "malt.reviewer.backend": {
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "host"
          ],
          "enumDescriptions": [
            "Docker container when Docker is running and Claude credentials are stored; otherwise the host daemon.",
            "Always use the Docker container (isolated, read-only workspace).",
            "Always run the reviewer as a process on this machine."
          ],
          "default": "auto",
          "markdownDescription": "Where the reviewer runs. Restart the reviewer after changing."
        },
        "malt.reviewer.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start the reviewer automatically when a workspace opens."
        },
        "malt.reviewer.triageModel": {
          "type": "string",
          "default": "sonnet",
          "markdownDescription": "Claude model for **block overviews** (one call per changed block). An alias (`haiku`, `sonnet`, `opus`) or a full model id. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.triageEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Claude Code's own default (no --effort flag)",
            "Quickest, least usage",
            "Balanced",
            "Deeper reasoning, more usage",
            "Much deeper reasoning",
            "Most thorough, most usage"
          ],
          "default": "low",
          "markdownDescription": "Reasoning effort for **block overviews**. Lower uses less. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.reviewModel": {
          "type": "string",
          "default": "haiku",
          "markdownDescription": "Claude model for **rule checks** (one call per applicable rule per block; most of the usage). An alias (`haiku`, `sonnet`, `opus`) or a full model id. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.reviewEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Claude Code's own default (no --effort flag)",
            "Quickest, least usage",
            "Balanced",
            "Deeper reasoning, more usage",
            "Much deeper reasoning",
            "Most thorough, most usage"
          ],
          "default": "low",
          "markdownDescription": "Reasoning effort for **rule checks**. Lower uses less. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.consolidationModel": {
          "type": "string",
          "default": "sonnet",
          "markdownDescription": "Claude model for **the consolidation check** (one call across the whole change). An alias (`haiku`, `sonnet`, `opus`) or a full model id. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.consolidationEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Claude Code's own default (no --effort flag)",
            "Quickest, least usage",
            "Balanced",
            "Deeper reasoning, more usage",
            "Much deeper reasoning",
            "Most thorough, most usage"
          ],
          "default": "low",
          "markdownDescription": "Reasoning effort for **the consolidation check**. Lower uses less. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.standardsModel": {
          "type": "string",
          "default": "opus",
          "markdownDescription": "Claude model for **Scan Project Standards** (three calls per scan). An alias (`haiku`, `sonnet`, `opus`) or a full model id. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.standardsEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Claude Code's own default (no --effort flag)",
            "Quickest, least usage",
            "Balanced",
            "Deeper reasoning, more usage",
            "Much deeper reasoning",
            "Most thorough, most usage"
          ],
          "default": "medium",
          "markdownDescription": "Reasoning effort for **Scan Project Standards**. Lower uses less. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.investigationModel": {
          "type": "string",
          "default": "sonnet",
          "markdownDescription": "Claude model for **gap investigations** (one call per gap you investigate; reads the real code behind the gap). An alias (`haiku`, `sonnet`, `opus`) or a full model id. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.investigationEffort": {
          "type": "string",
          "enum": [
            "default",
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "enumDescriptions": [
            "Claude Code's own default (no --effort flag)",
            "Quickest, least usage",
            "Balanced",
            "Deeper reasoning, more usage",
            "Much deeper reasoning",
            "Most thorough, most usage"
          ],
          "default": "medium",
          "markdownDescription": "Reasoning effort for **gap investigations**. Lower uses less. Also editable from **Models & effort** in the MALT Reviewer view. Applies when the reviewer restarts."
        },
        "malt.reviewer.maxConcurrentReviews": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 8,
          "description": "How many reviewer calls (block overviews and rule checks) run in parallel."
        },
        "malt.reviewer.claudePath": {
          "type": "string",
          "default": "claude",
          "scope": "machine",
          "markdownDescription": "Path to the Claude Code CLI, used by the host backend. Machine-level only: a repository's workspace settings can never set this, because it decides what MALT runs or connects to."
        },
        "malt.docker.socketPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Docker Engine socket or named pipe. Empty uses DOCKER_HOST or the platform default. Machine-level only: a repository's workspace settings can never set this, because it decides what MALT runs or connects to."
        },
        "malt.changes.autoOpen": {
          "type": "boolean",
          "default": true,
          "description": "Bring a file into view (without taking focus) when new changes appear in it. Paused while you are working; see Auto Open Pause Seconds."
        },
        "malt.changes.autoOpenPauseSeconds": {
          "type": "integer",
          "default": 60,
          "minimum": 0,
          "maximum": 3600,
          "markdownDescription": "While you are working (clicking, typing, scrolling, switching files, or opening something from MALT), auto-open waits until you have been idle this many seconds, so it never pulls you away from what you are investigating. New changes still appear in **Changes** right away."
        },
        "malt.changes.autoReview": {
          "type": "boolean",
          "default": true,
          "description": "Review each new changed block automatically."
        },
        "malt.changes.autoConsolidation": {
          "type": "boolean",
          "default": true,
          "description": "Check the whole change for code that should be consolidated (one reviewer call) 30 seconds after new files stop appearing."
        }
      }
    },
    "colors": [
      {
        "id": "malt.hunkPending",
        "description": "Outline of a changed block waiting for review.",
        "defaults": {
          "dark": "#8b949e",
          "light": "#6e7781",
          "highContrast": "#ffffff",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "malt.hunkPass",
        "description": "Outline of a changed block that passed review.",
        "defaults": {
          "dark": "#3fb950",
          "light": "#1a7f37",
          "highContrast": "#3fb950",
          "highContrastLight": "#1a7f37"
        }
      },
      {
        "id": "malt.hunkFail",
        "description": "Outline of a changed block that failed review.",
        "defaults": {
          "dark": "#f85149",
          "light": "#cf222e",
          "highContrast": "#f85149",
          "highContrastLight": "#cf222e"
        }
      },
      {
        "id": "malt.finding",
        "description": "Outline of the declaration a standards gap or consolidation finding points at.",
        "defaults": {
          "dark": "#d29922",
          "light": "#9a6700",
          "highContrast": "#d29922",
          "highContrastLight": "#9a6700"
        }
      },
      {
        "id": "malt.findingBackground",
        "description": "Background of the declaration a standards gap or consolidation finding points at.",
        "defaults": {
          "dark": "#d2992214",
          "light": "#9a670012",
          "highContrast": "#00000000",
          "highContrastLight": "#00000000"
        }
      }
    ]
  },
  "scripts": {
    "compile": "node scripts/compiler.mts compile",
    "watch": "node scripts/compiler.mts watch",
    "check-types": "node scripts/compiler.mts check",
    "lint": "node --permission --allow-fs-read=\"*\" node_modules/eslint/bin/eslint.js . --max-warnings 0",
    "check-deps": "node --permission --allow-fs-read=\"*\" scripts/check-deps.mts",
    "audit": "npm audit --audit-level=low && npm audit signatures",
    "test:toolchain": "node --test scripts/test/*.test.mjs",
    "test:compiler-sandbox": "node scripts/compiler.mts sandbox-test",
    "verify": "npm run check-deps && npm run check-types && npm run lint && npm run test:toolchain && npm run test:compiler-sandbox && npm test",
    "test": "npm run compile && npm run test:compiled",
    "test:compiled": "node out/test/runTest.js",
    "vscode:prepublish": "npm run compile",
    "vsix": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.6",
    "@types/vscode": "1.144.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.1.0",
    "eslint": "10.14.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1"
  },
  "overrides": {
    "@vscode/vsce@4.1.0": {
      "minimatch": "11.0.4"
    },
    "eslint@10.14.0": {
      "minimatch": "11.0.4"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.4"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.4"
    }
  },
  "icon": "media/icon.png",
  "keywords": [
    "code review",
    "AI",
    "Claude",
    "git",
    "standards",
    "developer tools"
  ],
  "galleryBanner": {
    "color": "#191D24",
    "theme": "dark"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In Restricted Mode, MALT ignores workspace values for settings that choose which programs it runs or connects to.",
      "restrictedConfigurations": [
        "malt.reviewer.claudePath",
        "malt.docker.socketPath"
      ]
    }
  }
}
